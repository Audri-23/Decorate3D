# =============================================================
#  DECORATE3D — Environment Variables Template
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to Git — only commit this .env.example
# =============================================================

# -------------------------------------------------------------
#  SERVER
# -------------------------------------------------------------
PORT=5001
NODE_ENV=development

# -------------------------------------------------------------
#  MONGODB ATLAS (Cloud Database)
#  Get connection string: https://cloud.mongodb.com
#  Cluster: decorate3d → Connect → Drivers → Node.js
# -------------------------------------------------------------
MONGO_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<YOUR_CLUSTER>.mongodb.net/decorate3d?retryWrites=true&w=majority&appName=Cluster0

# -------------------------------------------------------------
#  JWT (Authentication Tokens)
#  Use a long random string for production security
# -------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_here

# -------------------------------------------------------------
#  EMAIL (Gmail SMTP — Nodemailer)
#  Used for: 2FA OTP, order notifications, escrow alerts
#  EMAIL_PASS must be a Gmail App Password (NOT your main password)
#  Generate at: https://myaccount.google.com/apppasswords
# -------------------------------------------------------------
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# -------------------------------------------------------------
#  STRIPE PAYMENTS
#  Feature: f13-stripe-checkout, f14-escrow-holding
#  Get keys: https://dashboard.stripe.com/apikeys
#  Webhook:  https://dashboard.stripe.com/webhooks
# -------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# -------------------------------------------------------------
#  GOOGLE MAPS API (Frontend — Vite exposed)
#  Feature: f9-geo-map
#  Get key: https://developers.google.com/maps/documentation/javascript/get-api-key
#  IMPORTANT: Must start with VITE_ prefix to work in React/Vite
# -------------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# -------------------------------------------------------------
#  GOOGLE GEMINI AI API (Backend)
#  Feature: f1-damage-assessment (AI Furniture Inspector)
#  Get free key: https://aistudio.google.com/apikey
# -------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
